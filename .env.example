# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# =============================================================================
# REQUIRED
# =============================================================================

# --- Auth0 JWT validation (secures the /mcp endpoint) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_MCP_AUDIENCE=https://api.your-company.com

# --- Admin API key (protects /admin/* knowledge-base routes, x-api-key header) ---
ADMIN_API_KEY=your_admin_api_key

# --- OpenAI (embeddings for product + knowledge vector search) ---
OPENAI_API_KEY=sk-...

# --- Anthropic (Claude enrichment during knowledge-base ingestion) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- MetaKocka ERP API ---
MK_SECRET_KEY=your_secret_key
MK_COMPANY_ID=your_company_id
MK_BASE_URL=https://your-instance.metakocka.si/rest/eshop/v1
MK_WAREHOUSE_ID=your_warehouse_id

# --- Products export API (source for product vector index) ---
PRODUCTS_API_URL=https://api.time-4-action.com/api/export/product

# --- MongoDB (knowledge-base source metadata, parent chunks, BM25 index) ---
MONGO_URI=mongodb://localhost:27017/

# --- ChromaDB HTTP service (shared by product + knowledge collections) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# =============================================================================
# OPTIONAL
# =============================================================================

# Static API key for service-to-service access (e.g. n8n) — grants admin:all.
# If set, ADMIN_API_KEY falls back to this when ADMIN_API_KEY is unset.
API_KEY=

# MongoDB database name (default: t4a)
MONGO_DB_NAME=t4a

# ChromaDB knowledge collection name (default: company_knowledge)
CHROMA_COLLECTION=company_knowledge

# --- Scheduled product reindex (standard 5-field crontab syntax) ---
# Leave empty to disable the scheduler — reindexing then only happens
# on-demand via POST /admin/reindex-products. Example: daily at 03:00.
REINDEX_PRODUCTS_CRON=
# Timezone for the cron schedule above (default: UTC). e.g. Europe/Ljubljana
REINDEX_PRODUCTS_TZ=UTC

# --- Knowledge-base ingestion / retrieval tuning ---
# Claude model used for chunk enrichment (default: claude-haiku-4-5-20251001)
ENRICH_MODEL=claude-haiku-4-5-20251001
# Parent/child chunk sizes in tokens (defaults: 800/200)
PARENT_CHUNK_SIZE=800
CHILD_CHUNK_SIZE=200
# Number of reranked results returned by retrieval (default: 5)
TOP_K_RERANK=5

# --- Gmail IMAP Configuration (optional email tooling) ---
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993
